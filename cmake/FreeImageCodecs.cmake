# Optional system codecs: prefer exported CMake targets, then pkg-config,
# then an SDK's headers/import libraries (notably vcpkg's dynamic libjxl).
# The stable wrapper names are also reconstructed for installed consumers.
function(freeimage_find_codec codec minimum)
    set(wrapper "FreeImageCodec::${codec}")
    if(TARGET "${wrapper}")
        set(FreeImage_${codec}_FOUND TRUE PARENT_SCOPE)
        return()
    endif()
    set(provider "")
    set(version "")
    if(codec STREQUAL "HEIF")
        set(package libheif)
        set(header libheif/heif.h)
        set(libraries heif libheif)
        # Do not request a minimum here: some libheif version files use
        # SameMinorVersion and reject newer minor releases. Check it below.
        find_package(libheif CONFIG QUIET)
        set(version "${libheif_VERSION}")
        foreach(candidate libheif::heif heif::heif heif)
            if(TARGET "${candidate}")
                set(provider "${candidate}")
                break()
            endif()
        endforeach()
    elseif(codec STREQUAL "JXL")
        set(package libjxl)
        set(header jxl/decode.h)
        set(libraries jxl)
        find_package(JXL CONFIG QUIET NAMES JXL jxl libjxl)
        set(version "${JXL_VERSION}")
        foreach(candidate JXL::jxl jxl::jxl jxl)
            if(TARGET "${candidate}")
                set(provider "${candidate}")
                break()
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "Unknown FreeImage codec: ${codec}")
    endif()
    if(provider)
        if(version AND version VERSION_LESS minimum)
            set(FreeImage_${codec}_FOUND FALSE PARENT_SCOPE)
            set(FreeImage_${codec}_ERROR "${package} ${version} is too old; ${minimum} or newer is required" PARENT_SCOPE)
            return()
        endif()
        add_library("${wrapper}" INTERFACE IMPORTED)
        set_property(TARGET "${wrapper}" PROPERTY INTERFACE_LINK_LIBRARIES "${provider}")
        set(FreeImage_${codec}_FOUND TRUE PARENT_SCOPE)
        return()
    endif()

    # MSVC import libraries selected by a toolchain take precedence over
    # unrelated MSYS2/MinGW .pc files that happen to be on PATH.
    if(NOT (WIN32 AND MSVC))
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(FREEIMAGE_PC_${codec} QUIET IMPORTED_TARGET "${package}>=${minimum}")
            if(TARGET PkgConfig::FREEIMAGE_PC_${codec})
                add_library("${wrapper}" INTERFACE IMPORTED)
                set_property(TARGET "${wrapper}" PROPERTY INTERFACE_LINK_LIBRARIES "PkgConfig::FREEIMAGE_PC_${codec}")
                set(FreeImage_${codec}_FOUND TRUE PARENT_SCOPE)
                return()
            endif()
        endif()
    endif()

    find_path(FreeImage_${codec}_INCLUDE_DIR NAMES "${header}")
    find_library(FreeImage_${codec}_LIBRARY_RELEASE NAMES ${libraries})
    if(FreeImage_${codec}_LIBRARY_RELEASE)
        get_filename_component(libdir "${FreeImage_${codec}_LIBRARY_RELEASE}" DIRECTORY)
        find_library(FreeImage_${codec}_LIBRARY_DEBUG NAMES ${libraries}
            PATHS "${libdir}/../debug/lib" NO_DEFAULT_PATH)
    endif()
    set(include_dir "${FreeImage_${codec}_INCLUDE_DIR}")
    if(include_dir AND FreeImage_${codec}_LIBRARY_RELEASE)
        if(codec STREQUAL "HEIF" AND EXISTS "${include_dir}/libheif/heif_version.h")
            file(STRINGS "${include_dir}/libheif/heif_version.h" line REGEX "^#define[ \t]+LIBHEIF_VERSION[ \t]+\"")
            string(REGEX MATCH "\"([0-9]+\\.[0-9]+\\.[0-9]+)\"" match "${line}")
            set(version "${CMAKE_MATCH_1}")
        elseif(codec STREQUAL "JXL" AND EXISTS "${include_dir}/jxl/version.h")
            foreach(part MAJOR MINOR PATCH)
                file(STRINGS "${include_dir}/jxl/version.h" line REGEX "^#define[ \t]+JPEGXL_${part}_VERSION[ \t]+[0-9]+")
                string(REGEX MATCH "VERSION[ \t]+([0-9]+)" match "${line}")
                set(v_${part} "${CMAKE_MATCH_1}")
            endforeach()
            set(version "${v_MAJOR}.${v_MINOR}.${v_PATCH}")
        endif()
        if(version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" AND NOT version VERSION_LESS minimum)
            add_library("${wrapper}" UNKNOWN IMPORTED)
            set_target_properties("${wrapper}" PROPERTIES
                IMPORTED_LOCATION "${FreeImage_${codec}_LIBRARY_RELEASE}"
                INTERFACE_INCLUDE_DIRECTORIES "${include_dir}")
            if(FreeImage_${codec}_LIBRARY_DEBUG)
                set_target_properties("${wrapper}" PROPERTIES
                    IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
                    IMPORTED_LOCATION_RELEASE "${FreeImage_${codec}_LIBRARY_RELEASE}"
                    IMPORTED_LOCATION_DEBUG "${FreeImage_${codec}_LIBRARY_DEBUG}")
            endif()
            # An SDK with static codecs may need additional transitive libraries.
            set(FreeImage_${codec}_EXTRA_LIBRARIES "" CACHE STRING "Additional libraries required by a static ${package} SDK")
            if(FreeImage_${codec}_EXTRA_LIBRARIES)
                set_property(TARGET "${wrapper}" PROPERTY INTERFACE_LINK_LIBRARIES "${FreeImage_${codec}_EXTRA_LIBRARIES}")
            endif()
            set(FreeImage_${codec}_FOUND TRUE PARENT_SCOPE)
            return()
        endif()
    endif()
    if(WIN32 AND MSVC)
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(FREEIMAGE_PC_${codec} QUIET IMPORTED_TARGET "${package}>=${minimum}")
            if(TARGET PkgConfig::FREEIMAGE_PC_${codec})
                add_library("${wrapper}" INTERFACE IMPORTED)
                set_property(TARGET "${wrapper}" PROPERTY INTERFACE_LINK_LIBRARIES "PkgConfig::FREEIMAGE_PC_${codec}")
                set(FreeImage_${codec}_FOUND TRUE PARENT_SCOPE)
                return()
            endif()
        endif()
    endif()
    set(FreeImage_${codec}_FOUND FALSE PARENT_SCOPE)
    set(FreeImage_${codec}_ERROR
        "${package} >= ${minimum} was not found. Install its development SDK and set CMAKE_PREFIX_PATH (or use the vcpkg CMAKE_TOOLCHAIN_FILE). On Windows: vcpkg install ${package}:x64-windows. Enabling BUILD_LIB${codec} does not download the codec. Alternatively install pkg-config and expose ${package}.pc through PKG_CONFIG_PATH."
        PARENT_SCOPE)
endfunction()
