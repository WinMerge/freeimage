+++ b/cmake/freeimage.pc.in
@@ -0,0 +1,10 @@
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=${prefix}
+libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
+includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
+
+Name: FreeImage
+Description: Maintained FreeImage image decoding and conversion library
+Version: @PROJECT_VERSION@
+Libs: -L${libdir} -lfreeimage
+Cflags: -I${includedir}
